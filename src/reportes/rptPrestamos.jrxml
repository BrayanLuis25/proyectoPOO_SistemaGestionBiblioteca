	<queryString language="SQL">
		<![CDATA[SELECT pr.idPrestamo,
       p.nombres,
       l.titulo,
       pr.fechaPrestamo,
       pr.fechaDevolucion,
       pr.estado,
       pr.cantidadLibros
FROM prestamo pr
INNER JOIN persona p ON pr.idPersona = p.idPersona
INNER JOIN libro l ON pr.idLibro = l.idLibro]]>
	</queryString>
